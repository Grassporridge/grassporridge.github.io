---
import Layout from '../layouts/Layout.astro';
import NetworkCanvas from '../components/NetworkCanvas.tsx';
---

<Layout title="Home">
  <!-- Fixed full-page background -->
  <div slot="full-width" class="bg-canvas">
    <NetworkCanvas client:only="react" />
  </div>

  <!-- Hero text -->
  <div class="hero-content">
    <h1>Sarvesh Menon</h1>
    <p class="handle">Grassporridge</p>
    <p class="tagline">Systems Biology · Biological Aging · Microbial Ecology · Deep Learning · Bayesian Modelling</p>
    <a href="/blog" class="cta">See my work</a>
  </div>

  <!-- About -->
  <section class="about">
    <h2>About me</h2>
    <div class="about-grid">
      <div class="about-photo">
        <div class="photo-placeholder">Photo coming soon</div>
      </div>
      <div class="about-text">
        <p>
          I'm a PhD researcher in the <a href="https://www.venturellilab.org/" target="_blank">Venturelli Lab</a> in the
          Department of Biomedical Engineering at Duke University. My work sits at the intersection of
          microbial ecology, systems biology, and computational modelling — trying to understand how
          complex biological systems are organised and how they change over time.
        </p>
        <p>
          I've wanted to build a personal website for a while — somewhere to document side projects, track goals,
          and write about ideas outside of my day-to-day research. With LLMs making this finally tractable,
          I no longer have an excuse. This site and the projects here are being built in collaboration with Claude.
        </p>
        <p class="interests-line">
          <span class="interest-tag">Systems Biology</span>
          <span class="interest-tag">Biological Aging</span>
          <span class="interest-tag">Microbial Ecology</span>
          <span class="interest-tag">Deep Learning</span>
          <span class="interest-tag">Latent Representations</span>
          <span class="interest-tag">Bayesian Modelling</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Interests -->
  <section class="interests">
    <h2>What I explore</h2>
    <div class="cards">
      <div class="card">
        <span class="icon">🧬</span>
        <h3>Systems Biology</h3>
        <p>Modelling the emergent behaviour of biological networks — from gene regulation to cellular dynamics.</p>
      </div>
      <div class="card">
        <span class="icon">🧠</span>
        <h3>Deep Learning</h3>
        <p>Applying neural architectures to biological data: sequences, images, and multi-omics.</p>
      </div>
      <div class="card">
        <span class="icon">📊</span>
        <h3>Bayesian Modelling</h3>
        <p>Probabilistic reasoning and uncertainty quantification in complex biological systems.</p>
      </div>
      <div class="card">
        <span class="icon">⏳</span>
        <h3>Biological Aging</h3>
        <p>Understanding the molecular clocks and hallmarks of aging through computational lenses.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bg-canvas {
    position: fixed;
    inset: 0;
    background: #0a0f1e;
    z-index: -1;
  }

  :global(main) { position: relative; z-index: 1; }

  /* Hero */
  .hero-content {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .handle {
    margin-top: 0.4rem;
    color: rgba(255,255,255,0.35);
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  .tagline {
    margin-top: 1rem;
    color: #38bdb7;
    font-size: clamp(0.8rem, 2vw, 1rem);
    letter-spacing: 0.04em;
  }

  .cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.7rem 1.8rem;
    border: 1px solid #38bdb7;
    color: #38bdb7;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
  }
  .cta:hover { background: #38bdb7; color: #0a0f1e; }

  /* About */
  .about {
    padding: 4rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .about h2, .interests h2 {
    font-size: 1.4rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 600px) {
    .about-grid { grid-template-columns: 1fr; }
  }

  .photo-placeholder {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px dashed rgba(56,189,183,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.25);
    font-size: 0.8rem;
  }

  .about-text { display: flex; flex-direction: column; gap: 1rem; }

  .about-text p {
    color: #9ca3af;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .about-text a {
    color: #38bdb7;
    text-decoration: none;
  }
  .about-text a:hover { text-decoration: underline; }

  .interests-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .interest-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(56,189,183,0.3);
    border-radius: 999px;
    color: #38bdb7;
  }

  /* Interests cards */
  .interests {
    padding: 4rem 0 6rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.25rem;
  }

  .card {
    border: 1px solid rgba(56, 189, 183, 0.25);
    border-radius: 8px;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(6px);
    transition: background 0.2s, border-color 0.2s;
  }
  .card:hover {
    background: rgba(56, 189, 183, 0.08);
    border-color: rgba(56, 189, 183, 0.5);
  }

  .icon { font-size: 1.8rem; }
  .card h3 { margin-top: 0.75rem; font-size: 1rem; color: #fff; }
  .card p { margin-top: 0.5rem; font-size: 0.875rem; color: #9ca3af; line-height: 1.5; }
</style>
