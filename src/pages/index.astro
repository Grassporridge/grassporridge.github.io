---
import Layout from '../layouts/Layout.astro';
import NetworkCanvas from '../components/NetworkCanvas.tsx';
---

<Layout title="Home">
  <!-- Fixed full-page background -->
  <div slot="full-width" class="bg-canvas">
    <NetworkCanvas client:only="react" />
  </div>

  <!-- Hero text -->
  <div class="hero-content">
    <h1>Sarvesh Menon</h1>
    <p class="handle">Grassporridge</p>
    <p class="tagline">Systems Biology · Biological Aging · Microbial Ecology · Deep Learning · Latent Representations · Bayesian Modelling</p>
    <div class="cta-group">
      <a href="/blog" class="cta">Monthly Projects</a>
      <a href="/cv" class="cta">Curriculum Vitae</a>
      <a href="/goals" class="cta">Goal Tracker</a>
      <a href="/contact" class="cta">Reach Out</a>
    </div>
  </div>

  <!-- About -->
  <section class="about">
    <h2>About me</h2>
    <div class="about-grid">
      <div class="about-photo">
        <div class="photo-placeholder">Photo coming soon</div>
      </div>
      <div class="about-text">
        <p>
          I'm a PhD researcher in the <a href="https://www.venturellilab.org/" target="_blank">Venturelli Lab</a> in the
          Department of Biomedical Engineering at Duke University. My work sits at the intersection of
          microbial ecology, systems biology, and computational modelling; trying to understand how
          complex biological systems are organised to give rise to function, and how those systems
          themselves change across time.
        </p>
        <p>
          I've wanted to build a personal website for a while, somewhere to document side projects, track goals,
          and write about ideas outside of my day-to-day research. With LLMs making this finally tractable,
          I no longer have an excuse. This site and the projects here are being built in collaboration with Claude.
        </p>
      </div>
    </div>
  </section>

  <!-- Personal Interests -->
  <section class="personal">
    <h2>Outside the lab</h2>
    <p class="personal-bio">
      I enjoy physical activity; my most recent endeavour has been rock climbing (bouldering >> top-rope),
      hitting the gym, and playing tennis, football (soccer), and basketball. I practice the keyboard and am learning Mandarin, albeit being
      objectively awful at both still.
    </p>
    <p class="personal-bio">
      I absolutely love animals and insects alike (except for you, cockroaches). I would love to work at
      an animal sanctuary if my current trajectory fails me.
    </p>
    <div class="personal-cards">
      <div class="personal-card">
        <span class="icon">🧗</span>
        <span>Rock Climbing</span>
      </div>
      <div class="personal-card">
        <span class="icon">🎾</span>
        <span>Tennis</span>
      </div>
      <div class="personal-card">
        <span class="icon">🏋️</span>
        <span>Gym</span>
      </div>
      <div class="personal-card">
        <span class="icon">🎹</span>
        <span>Piano</span>
      </div>
      <div class="personal-card">
        <span class="icon">🈶</span>
        <span>Mandarin</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bg-canvas {
    position: fixed;
    inset: 0;
    background: #0a0f1e;
    z-index: -1;
  }

  :global(main) { position: relative; z-index: 1; }

  /* Hero */
  .hero-content {
    min-height: 65vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .handle {
    margin-top: 0.4rem;
    color: rgba(255,255,255,0.35);
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  .tagline {
    margin-top: 1rem;
    color: #38bdb7;
    font-size: clamp(0.8rem, 2vw, 1rem);
    letter-spacing: 0.04em;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
  }

  .cta {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    border: 1px solid #38bdb7;
    color: #38bdb7;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
  }
  .cta:hover { background: #38bdb7; color: #0a0f1e; }

  /* About */
  .about {
    padding: 2.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .about h2, .personal h2 {
    font-size: 1.4rem;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 600px) {
    .about-grid { grid-template-columns: 1fr; }
  }

  .photo-placeholder {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    border: 1px dashed rgba(56,189,183,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.25);
    font-size: 0.8rem;
  }

  .about-text { display: flex; flex-direction: column; gap: 1rem; }

  .about-text p {
    color: #9ca3af;
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .about-text a {
    color: #38bdb7;
    text-decoration: none;
  }
  .about-text a:hover { text-decoration: underline; }

  /* Personal Interests */
  .personal {
    padding: 2.5rem 0 4rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .personal-bio {
    color: #9ca3af;
    line-height: 1.7;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .personal-cards {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .personal-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(56,189,183,0.25);
    border-radius: 8px;
    background: rgba(255,255,255,0.04);
    color: #e5e5e5;
    font-size: 0.95rem;
    transition: background 0.2s, border-color 0.2s;
  }
  .personal-card:hover {
    background: rgba(56,189,183,0.08);
    border-color: rgba(56,189,183,0.5);
  }

  .icon { font-size: 1.4rem; }
</style>
