---
import Layout from '../layouts/Layout.astro';
import NetworkCanvas from '../components/NetworkCanvas.tsx';
---

<Layout title="Home">
  <!-- Fixed full-page background -->
  <div slot="full-width" class="bg-canvas">
    <NetworkCanvas client:only="react" />
  </div>

  <!-- Hero text -->
  <div class="hero-content">
    <h1>Grassporridge</h1>
    <p class="tagline">Systems Biology · Deep Learning · Bayesian Modelling · Biological Aging</p>
    <a href="/blog" class="cta">See my work</a>
  </div>

  <!-- Interests -->
  <section class="interests">
    <h2>What I explore</h2>
    <div class="cards">
      <div class="card">
        <span class="icon">🧬</span>
        <h3>Systems Biology</h3>
        <p>Modelling the emergent behaviour of biological networks — from gene regulation to cellular dynamics.</p>
      </div>
      <div class="card">
        <span class="icon">🧠</span>
        <h3>Deep Learning</h3>
        <p>Applying neural architectures to biological data: sequences, images, and multi-omics.</p>
      </div>
      <div class="card">
        <span class="icon">📊</span>
        <h3>Bayesian Modelling</h3>
        <p>Probabilistic reasoning and uncertainty quantification in complex biological systems.</p>
      </div>
      <div class="card">
        <span class="icon">⏳</span>
        <h3>Biological Aging</h3>
        <p>Understanding the molecular clocks and hallmarks of aging through computational lenses.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* fixed canvas behind everything */
  .bg-canvas {
    position: fixed;
    inset: 0;
    background: #0a0f1e;
    z-index: -1;
  }

  /* make main content readable over dark bg */
  :global(body) { background: #0a0f1e; }
  :global(main) { position: relative; z-index: 1; }

  .hero-content {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin-top: 1rem;
    color: #38bdb7;
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    letter-spacing: 0.04em;
  }

  .cta {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.7rem 1.8rem;
    border: 1px solid #38bdb7;
    color: #38bdb7;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
  }
  .cta:hover { background: #38bdb7; color: #0a0f1e; }

  .interests {
    padding: 4rem 0 6rem;
  }

  .interests h2 {
    font-size: 1.6rem;
    margin-bottom: 2rem;
    color: #fff;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.25rem;
  }

  .card {
    border: 1px solid rgba(56, 189, 183, 0.25);
    border-radius: 8px;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(6px);
    transition: background 0.2s, border-color 0.2s;
  }
  .card:hover {
    background: rgba(56, 189, 183, 0.08);
    border-color: rgba(56, 189, 183, 0.5);
  }

  .icon { font-size: 1.8rem; }
  .card h3 { margin-top: 0.75rem; font-size: 1rem; color: #fff; }
  .card p { margin-top: 0.5rem; font-size: 0.875rem; color: #9ca3af; line-height: 1.5; }
</style>
