---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <h1>Contact</h1>
  <p class="sub">Feel free to reach out about research, collaborations, or just to say hi.</p>

  <div class="links">
    <a href="mailto:sarveshmenon00@gmail.com" class="link-item">
      <span class="label">Email</span>
      <span class="value">sarveshmenon00@gmail.com</span>
    </a>
    <a href="https://github.com/Grassporridge" target="_blank" class="link-item">
      <span class="label">GitHub</span>
      <span class="value">Grassporridge</span>
    </a>
  </div>
</Layout>

<style>
  h1 { font-size: 2rem; color: #fff; }
  .sub { margin-top: 0.75rem; color: #9ca3af; }

  .links {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(56, 189, 183, 0.25);
    border-radius: 8px;
    text-decoration: none;
    color: #fff;
    background: rgba(255,255,255,0.04);
    transition: background 0.2s, border-color 0.2s;
  }
  .link-item:hover { background: rgba(56,189,183,0.08); border-color: rgba(56,189,183,0.5); }

  .label { font-size: 0.8rem; color: #9ca3af; width: 60px; }
  .value { font-weight: 500; }
</style>
