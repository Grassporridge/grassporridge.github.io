---
import Layout from '../layouts/Layout.astro';

interface Goal    { text: string; completed?: boolean; date?: string; }
interface Sub     { title: string; goals: Goal[]; imgSrc: string; imgAlt: string; imgFlex: number; }
interface Section { title: string; direct?: Goal[]; subsections?: Sub[]; imgSrc?: string; imgAlt?: string; imgFlex?: number; }

const IMG = (id: string) => `https://images.unsplash.com/photo-${id}?w=280&fit=crop&q=80`;

const sections: Section[] = [
  {
    title: 'Overall',
    imgSrc: IMG('1523580846011-d3a5bc25702b'), imgAlt: 'Graduation', imgFlex: 1,
    direct: [
      { text: 'Get my PhD' },
    ],
  },
  {
    title: 'Fitness',
    direct: [{ text: 'Drop down to 73 Kg' }],
    subsections: [
      { title: 'Climbing',      imgSrc: IMG('1522163182402-834f871fd851'), imgAlt: 'Rock climbing',  imgFlex: 3,
        goals: [
          { text: 'Climb a V4 Boulder', completed: true, date: 'Feb 10, 2026' },
          { text: 'Climb a V5 Boulder', completed: true, date: 'Mar 28, 2026' },
          { text: 'Climb a V6 Boulder' }, { text: 'Climb a V7 Boulder' },
          { text: 'Climb a 5c Route' },   { text: 'Climb a 6a+ Route' }, { text: 'Climb a 6c Route' },
        ],
      },
      { title: 'Weight Lifting', imgSrc: IMG('1534438327276-14e5300c3a48'), imgAlt: 'Gym', imgFlex: 3.5,
        goals: [
          { text: 'Bench bodyweight' },        { text: 'Bench 100 Kg' },
          { text: 'Squat 1.5x bodyweight' },   { text: 'Squat 100 Kg' },
          { text: 'Deadlift 140 Kg' },          { text: 'Deadlift 2x bodyweight' },
          { text: '10 Pullups' },               { text: 'Weighted Pullup 20 Kg' }, { text: 'One-armed Pullup' },
        ],
      },
      { title: 'Tennis', imgSrc: IMG('1554068865-24cecd4e34b8'), imgAlt: 'Tennis', imgFlex: 1,
        goals: [
          { text: 'Beat Aaron Yip (handicapped to play lefty forehand) in a 5 set, 11 point game' },
        ],
      },
      { title: 'Running', imgSrc: IMG('1476480862126-209bfaa8edc8'), imgAlt: 'Running', imgFlex: 2,
        goals: [
          { text: '6 minute mile' }, { text: '30 minute 5K' },
          { text: '1 hour 10K' },    { text: 'Run a half-marathon' }, { text: 'Run a full marathon' },
        ],
      },
    ],
  },
  {
    title: 'Piano',
    imgSrc: IMG('1520523839897-bd0b52f945a0'), imgAlt: 'Piano keys', imgFlex: 1.5,
    direct: [
      { text: 'Sweden by C418' },
      { text: 'Nuvole Bianche by Ludovico Einaudi' },
      { text: 'Chords to Blue by Yung Kai' },
    ],
  },
  {
    title: 'Language',
    imgSrc: IMG('1528360983277-13d401cdc186'), imgAlt: 'Asian lanterns', imgFlex: 1.5,
    direct: [
      { text: 'A2 proficiency in Mandarin' },
      { text: 'B1 proficiency in Mandarin' },
      { text: 'B2 proficiency in Mandarin' },
    ],
  },
  {
    title: 'Recreation',
    imgSrc: IMG('1544551763-46a013bb70d5'), imgAlt: 'Scuba diving', imgFlex: 1.5,
    direct: [
      { text: 'Visit every continent (Visited: Asia, North America, Africa, Europe)' },
      { text: 'Skydive' }, { text: 'Scuba dive' }, { text: 'Shark cage dive' },
    ],
  },
];

// Flatten image strip entries in order
const imgStrip: { src: string; alt: string; flex: number }[] = [];
for (const s of sections) {
  if (s.subsections) {
    for (const sub of s.subsections) imgStrip.push({ src: sub.imgSrc, alt: sub.imgAlt, flex: sub.imgFlex });
  } else if (s.imgSrc) {
    imgStrip.push({ src: s.imgSrc, alt: s.imgAlt ?? '', flex: s.imgFlex ?? 1 });
  }
}
---

<Layout title="Goals">
  <div slot="full-width" class="goals-page">

    <!-- Left: goals content -->
    <div class="goals-left">
      <div class="goals-inner">
        <h1>Goal Tracker</h1>

        {sections.map(section => (
          <div class="section">
            <h2 class="section-title">{section.title}</h2>

            {section.direct?.map(g => (
              <div class={`goal-row ${g.completed ? 'completed' : ''}`}>
                <div class={`cb ${g.completed ? 'checked' : ''}`}>
                  {g.completed && <svg viewBox="0 0 12 12" width="10" height="10"><polyline points="1.5,6 4.5,9 10.5,3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </div>
                <span class="goal-text">{g.text}</span>
                <span class="goal-date">{g.date ?? ''}</span>
              </div>
            ))}

            {section.subsections?.map(sub => (
              <div class="subsection">
                <h3 class="subsection-title">{sub.title}</h3>
                {sub.goals.map(g => (
                  <div class={`goal-row ${g.completed ? 'completed' : ''}`}>
                    <div class={`cb ${g.completed ? 'checked' : ''}`}>
                      {g.completed && <svg viewBox="0 0 12 12" width="10" height="10"><polyline points="1.5,6 4.5,9 10.5,3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                    </div>
                    <span class="goal-text">{g.text}</span>
                    <span class="goal-date">{g.date ?? ''}</span>
                  </div>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Right: continuous image strip -->
    <div class="goals-right">
      {imgStrip.map(img => (
        <div class="strip-img" style={`flex: ${img.flex}`}>
          <img src={img.src} alt={img.alt} />
        </div>
      ))}
    </div>

  </div>
</Layout>

<style>
  .goals-page {
    display: flex;
    align-items: stretch;
    min-height: calc(100vh - 58px);
    color: #e5e5e5;
    font-family: system-ui, sans-serif;
  }

  /* Left column */
  .goals-left {
    flex: 1;
    overflow: hidden;
  }
  .goals-inner {
    max-width: 820px;
    padding: 2.5rem 2rem 4rem 3rem;
  }

  h1 { font-size: 2rem; color: #fff; margin-bottom: 2rem; }

  .section { margin-bottom: 2.5rem; }

  .section-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid rgba(56,189,183,0.3);
    padding-bottom: 0.45rem;
    margin-bottom: 0.7rem;
  }

  .subsection { margin: 0.9rem 0 0 1.5rem; }

  .subsection-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: #38bdb7;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.45rem;
  }

  .goal-row {
    display: grid;
    grid-template-columns: 17px 1fr auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.32rem 0.4rem;
    margin-left: 1rem;
  }

  .cb {
    width: 14px; height: 14px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: #0a0f1e;
  }
  .cb.checked { background: #38bdb7; border-color: #38bdb7; }

  .goal-text { font-size: 0.88rem; color: #c8d0e0; line-height: 1.4; }
  .completed .goal-text { text-decoration: line-through; color: rgba(200,208,224,0.3); }

  .goal-date {
    font-size: 0.76rem;
    color: #38bdb7;
    white-space: nowrap;
    min-width: 100px;
    text-align: right;
  }

  /* Right image strip */
  .goals-right {
    width: 260px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-self: stretch;
  }

  .strip-img {
    overflow: hidden;
    min-height: 0;
  }

  .strip-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 760px) {
    .goals-right { display: none; }
  }
</style>
