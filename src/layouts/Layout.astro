---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; color: #1a1a1a; }
      nav { display: flex; gap: 2rem; padding: 1.25rem 2rem; border-bottom: 1px solid #e5e5e5; }
      nav a { text-decoration: none; color: #555; font-size: 0.95rem; }
      nav a:hover, nav a.active { color: #000; font-weight: 600; }
      main { max-width: 800px; margin: 0 auto; padding: 3rem 2rem; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/blog">Blog</a>
      <a href="/cv">CV</a>
      <a href="/goals">Goals</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
